 nu = f_BW2, delay = delay_BW2,
 radius = radius_BW2)
AT (0.03140505829452013, 0.0, 40.0) ABSOLUTE
ROTATED (0, 0.16273933122724, 0) ABSOLUTE

COMPONENT B2_monitor_xy = Monitor_nD(
 xwidth = 0.06, yheight = 0.085,
 restore_neutron = 1, options = "x limits [-0.0375:0.0375] bins = 100, y limits [-0.05:0.05] bins = 100",
 filename = "BW2_monitor_xy.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT B2_monitor_lam = Monitor_nD(
