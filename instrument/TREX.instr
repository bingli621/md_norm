* Instrument: TRex
* 
* %Identification
* Written by: Bing Li
* Date: 19:35:02 on August 10, 2026
* Origin: DMSC
* %INSTRUMENT_SITE: Generated_instruments
* 
* !!Please write a short instrument description (1 line) here!!
* 
* %Description
* Please write a longer instrument description here!
* 
* 
* %Parameters
* L0: [unit] wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
* d_Li: [unit] wavelength band in [Å] to be simulated
* RRM: [unit] repetition rate multiplication
* phase_P: [unit] angular offset for the P-Chopper {0: 20deg Opening, 55: 35deg Opening}
* mod_type: [unit] this variable determines which moderator type is used {0: Thermal moderator, 1: Bispectral moderator, 2: Cold moderator}
* bender: [unit] bender out = 0, bender in = 1
* b_rot: [unit] in [deg], rotation of the cold neutron bender
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT TRex (
L0 = 2.4, // wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
d_Li = 0.845, // wavelength band in [Å] to be simulated
int RRM = 18, // repetition rate multiplication
int phase_P = 0, // angular offset for the P-Chopper {0: 20deg Opening, 55: 35deg Opening}
int mod_type = 1, // this variable determines which moderator type is used {0: Thermal moderator, 1: Bispectral moderator, 2: Cold moderator}
int bender = 0, // bender out = 0, bender in = 1
b_rot = -0.5 // in [deg], rotation of the cold neutron bender
)

DECLARE 
%{
double frac; // Used in the Source component. Defines the statistical fraction of eventsemitted from the cold part of the moderator, the value is determined later in the file depending on the moderator type that was chosen
double lamb_1; // Wavelength min in [AA]
double lamb_2; // Wavelength max in [AA]
double T_offset = 0.0017; // Time offset in [s] to shift to the center of long pulse
double f = 14.0; // Source frequency in [Hz]
double rTopUpPar[5] = {0.99,0.0219,3.02,4.0,0.003};
double rTopDownPar[5] = {0.99,0.0219,3.02,4.0,0.003};


double tof_BW1, tof_BW2, tof_P1, tof_P2, tof_M1, tof_M2;

// characteristic wavelength
double v0;

// distances
double L_BW1 = 32;
double L_BW2 = 40;
double L_P1 = 107.95;
double L_P2 = 108.05;
double L_M1 = 161.995;
double L_M2 = 162.005;




// BW1 Chopper
double f_BW1;
double delay_BW1; //time delay

double radius_BW1 = 0.35;
double slit_height_BW1 = 0.095; // FIXME
double nslits_BW1 = 1;
double theta_pos_BW1 = 0;
double theta_width_BW1 = 61.4;

// BW2 Chopper
double f_BW2;
double delay_BW2; //time delay

double radius_BW2 = 0.35;
double slit_height_BW2 = 0.095; // FIXME
double nslits_BW2 = 1;
double theta_pos_BW2 = 0;
double theta_width_BW2 = 63.3;

// P1 Chopper
double f_P1;
double phase_P1;// angular delay
double delay_P1_HR; //time delay
double delay_P1_HF; //time delay

double radius_P1 = 0.35;
double slit_height_P1 = 0.095;
double nslits_P1 = 2;
double theta_pos_P1_HR = 0;
double theta_pos_P1_HF = -55;
double theta_width_P1_HR = 20;
double theta_width_P1_HF = 35;

// P2 Chopper
double f_P2;
double phase_P2;// angular delay
double delay_P2_HR; //time delay
double delay_P2_HF; //time delay

double radius_P2 = 0.35;
double slit_height_P2 = 0.095;
double nslits_P2 = 2;
double theta_pos_P2_HR = 0;
double theta_pos_P2_HF = -55;
double theta_width_P2_HR = 20;
double theta_width_P2_HF = 35;



 // M1 Chopper
double f_M1;
double phase_M1;// angular delay
double delay_M1_HR; //time delay
double delay_M1_HF; //time delay

double radius_M1 = 0.35;
double slit_height_M1 = 0.045; 
double nslits_M1 = 1;
double theta_pos_M1_HR = 180;
double theta_pos_M1_HF = 5;
double theta_width_M1_HR = 2.5;
double theta_width_M1_HF = 4.3;


// M2 Chopper
double f_M2;
double phase_M2;// angular delay
double delay_M2_HR; //time delay
double delay_M2_HF; //time delay

double radius_M2 = 0.35;
double slit_height_M2 = 0.045; 
double nslits_M2 = 1;
double theta_pos_M2_HR = 0;
double theta_pos_M2_HF = -175;
double theta_width_M2_HR = 2.5;
double theta_width_M2_HF = 4.3;



%}

INITIALIZE 
%{
// Start of initialize for generated TRex

// Source type
switch (mod_type)
	{
	case 0: {frac = 0.0; break;} // Thermal moderator
	case 1: {frac = 0.5; break;} // Bispectral moderator
	case 2: {frac = 1.0; break;} // Cold moderator
	}
// Source parameters
lamb_1 = L0-d_Li*1.1;
lamb_2 = L0+d_Li*1.1;

printf("lamb_1: %g \n", lamb_1);
printf("lamb_2: %g \n", lamb_2);

// frequencies
f_BW1 = f;
f_BW2 = f_BW1;
f_P1 = RRM*f*0.75;
f_P2 = -f_P1;

// characteristic wavelength 

v0 = 2*PI*K2V/L0;       // speed center neutron


// time of flight and chopper phases
tof_BW1 = T_offset + L_BW1/v0;
tof_BW2 = T_offset + L_BW2/v0;
tof_P1 = T_offset + L_P1/v0;
tof_P2 = T_offset + L_P2/v0;
tof_M1 = T_offset + L_M1/v0;
tof_M2 = T_offset + L_M2/v0;

/* Chopper parameters */

// BW1 Chopper
delay_BW1 = tof_BW1 + theta_pos_BW1/f_BW1/360; // time delay

// BW2 Chopper
delay_BW2 = tof_BW2 + theta_pos_BW2/f_BW2/360; // time delay

// P1 Chopper
delay_P1_HR = tof_P1 + theta_pos_P1_HR/f_P1/360; //time delay
delay_P1_HF = tof_P1 + theta_pos_P1_HF/f_P1/360; //time delay

// P2 Chopper
delay_P2_HR = tof_P2 + theta_pos_P2_HR/f_P2/360; //time delay
delay_P2_HF = tof_P2 + theta_pos_P2_HF/f_P2/360; //time delay

// M1 Chopper
delay_M1_HR = tof_M1 + theta_pos_M1_HR/f_M1/360; //time delay
delay_M1_HF = tof_M1 + theta_pos_M1_HF/f_M1/360; //time delay

// M2 Chopper
delay_M2_HR = tof_M2 + theta_pos_M2_HR/f_M2/360; //time delay
delay_M2_HF = tof_M2 + theta_pos_M2_HF/f_M2/360; //time delay




%}

TRACE 
COMPONENT source = ESS_butterfly(
 sector = "W", beamline = 7,
 yheight = 0.03, cold_frac = frac,
 dist = 2, focus_xw = 0.095,
 focus_yh = 0.035, Lmin = lamb_1,
 Lmax = lamb_2, n_pulses = 1,
 acc_power = 2, tfocus_dist = L_BW1,
 tfocus_time = tof_BW1, tfocus_width = 0.02)
AT (0, 0, 0) ABSOLUTE

// Note: -0.002 because guide is asymmetric here (47mm-43mm)/2
COMPONENT source_monitor_xy = Monitor_nD(
 xwidth = 0.1, yheight = 0.04,
 restore_neutron = 1, options = "x limits [-0.06:0.06] bins = 100, y limits [-0.03:0.03] bins = 100",
 filename = "source_monitor_xy.dat")
AT (-0.002, 0, 1.8953) ABSOLUTE

COMPONENT source_monitor_div = Monitor_nD(
 xwidth = 0.09, yheight = 0.03,
 restore_neutron = 1, options = "hdiv limits [-4.5:4.5] bins = 100, vdiv limits [-2.5:2.5] bins = 100",
 filename = "source_monitor_div.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT source_monitor_lam = Monitor_nD(
 xwidth = 0.09, yheight = 0.03,
 restore_neutron = 1, options = "lambda limits [0.5:7.0] bins = 130",
 filename = "source_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// NBOA section
COMPONENT guide_0 = Guide_anyshape_r(
 geometry = "./OFF_files/try0.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_1 = Guide_anyshape_r(
 geometry = "./OFF_files/try1.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_3 = Guide_anyshape_r(
 geometry = "./OFF_files/try3.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_4 = Guide_anyshape_r(
 geometry = "./OFF_files/try4.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_5 = Guide_anyshape_r(
 geometry = "./OFF_files/try5.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_7 = Guide_anyshape_r(
 geometry = "./OFF_files/try7.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_8 = Guide_anyshape_r(
 geometry = "./OFF_files/try8.off")
AT (0, 0, 0) ABSOLUTE

// BBGOA: thermal -> guide 10 & 11; cold: bender & guide 11
COMPONENT guide_10 = Guide_anyshape_r(
 geometry = "./OFF_files/try10.off")
WHEN (bender==0)
AT (0, 0, 0) ABSOLUTE

// bender: 63.84mm x 46mm x 50mm (WxHxL), 0.15mm Si channels/ NiTi m=4 curve=7.2m
COMPONENT bender = Pol_bender(
 xwidth = 0.06384, yheight = 0.046,
 length = 0.05, radius = 7.2,
 nslit = 425, d = 1e-06,
 endFlat = 0, rTopUpPar = rTopUpPar,
 rTopDownPar = rTopDownPar, drawOption = 2)
WHEN (bender==1)
AT (-0.017, 0, 5.399) ABSOLUTE
ROTATED (0.00192, b_rot, 0) ABSOLUTE

COMPONENT guide_11 = Guide_anyshape_r(
 geometry = "./OFF_files/try11.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT slit = Slit(
 xwidth = 0.06, yheight = 0.046)
AT (-0.017, 0, 5.915) ABSOLUTE

COMPONENT insert_monitor_xy = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "x limits [-0.04:0.04] bins = 100, y limits [-0.033:0.033] bins = 100",
 filename = "insert_monitor_xy.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT insert_monitor_div = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "hdiv limits [-2.0:2.0] bins = 201, vdiv limits [-1.0:1.0] bins = 201",
 filename = "insert_monitor_div.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT insert_monitor_lam = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "lambda limits [0.5:7.0] bins = 130",
 filename = "insert_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT inset_monitor_ToF = Monitor_nD(
 xwidth = 0.07, yheight = 0.07,
 restore_neutron = 1, options = "t limits [0.0:0.020] bins = 20000",
 filename = "inset_monitor_ToF.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// In-bunker section plus a little bit
COMPONENT guide_13 = Guide_anyshape_r(
 geometry = "./OFF_files/try13.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_14 = Guide_anyshape_r(
 geometry = "./OFF_files/try14.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_15 = Guide_anyshape_r(
 geometry = "./OFF_files/try15.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_16 = Guide_anyshape_r(
 geometry = "./OFF_files/try16.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_18 = Guide_anyshape_r(
 geometry = "./OFF_files/try18.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_19 = Guide_anyshape_r(
 geometry = "./OFF_files/try19.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_20 = Guide_anyshape_r(
 geometry = "./OFF_files/try20.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_22 = Guide_anyshape_r(
 geometry = "./OFF_files/try22.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_23 = Guide_anyshape_r(
 geometry = "./OFF_files/try23.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_24 = Guide_anyshape_r(
 geometry = "./OFF_files/try24.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_25 = Guide_anyshape_r(
 geometry = "./OFF_files/try25.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_27 = Guide_anyshape_r(
 geometry = "./OFF_files/try27.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_28 = Guide_anyshape_r(
 geometry = "./OFF_files/try28.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_29 = Guide_anyshape_r(
 geometry = "./OFF_files/try29.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_30 = Guide_anyshape_r(
 geometry = "./OFF_files/try30.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_32 = Guide_anyshape_r(
 geometry = "./OFF_files/try32.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_33 = Guide_anyshape_r(
 geometry = "./OFF_files/try33.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_34 = Guide_anyshape_r(
 geometry = "./OFF_files/try34.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_36 = Guide_anyshape_r(
 geometry = "./OFF_files/try36.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_37 = Guide_anyshape_r(
 geometry = "./OFF_files/try37.off")
AT (0, 0, 0) ABSOLUTE

// Bunker wall insert starts here
COMPONENT guide_39 = Guide_anyshape_r(
 geometry = "./OFF_files/try39.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_40 = Guide_anyshape_r(
 geometry = "./OFF_files/try40.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_41 = Guide_anyshape_r(
 geometry = "./OFF_files/try41.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_42 = Guide_anyshape_r(
 geometry = "./OFF_files/try42.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_44 = Guide_anyshape_r(
 geometry = "./OFF_files/try44.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_45 = Guide_anyshape_r(
 geometry = "./OFF_files/try45.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_46 = Guide_anyshape_r(
 geometry = "./OFF_files/try46.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_47 = Guide_anyshape_r(
 geometry = "./OFF_files/try47.off")
AT (0, 0, 0) ABSOLUTE

// Bandwidth chopper 1
COMPONENT BW_Chopper_1 = DiskChopper(
 theta_0 = theta_width_BW1, radius = radius_BW1,
 yheight = slit_height_BW1, nu = f_BW1,
 nslit = nslits_BW1, delay = delay_BW1)
AT (0.011348994153930106, 0.0, 32.0) ABSOLUTE
ROTATED (0, 0.12454202414165, 0) ABSOLUTE

COMPONENT B1_monitor_xy = Monitor_nD(
 xwidth = 0.07, yheight = 0.09,
 restore_neutron = 1, options = "x limits [-0.035:0.035] bins = 100, y limits [-0.045:0.045] bins = 100",
 filename = "BW1_monitor_xy.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT B1_monitor_lam = Monitor_nD(
 xwidth = 0.07, yheight = 0.09,
 restore_neutron = 1, options = "lambda limits [0.5:10.0] bins = 130",
 filename = "BW1_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT BW1_monitor_ToF = Monitor_nD(
 xwidth = 0.07, yheight = 0.09,
 restore_neutron = 1, options = "t limits [0.0:0.050] bins = 20000",
 filename = "BW1_monitor_ToF.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// Bandwidth chopper 2
COMPONENT BW_Chopper_2 = DiskChopper(
 theta_0 = theta_width_BW2, radius = radius_BW2,
 yheight = slit_height_BW2, nu = f_BW2,
 nslit = nslits_BW2, delay = delay_BW2)
AT (0.03140505829452013, 0.0, 40.0) ABSOLUTE
ROTATED (0, 0.16273933122724, 0) ABSOLUTE

COMPONENT B2_monitor_xy = Monitor_nD(
 xwidth = 0.06, yheight = 0.085,
 restore_neutron = 1, options = "x limits [-0.0375:0.0375] bins = 100, y limits [-0.05:0.05] bins = 100",
 filename = "BW2_monitor_xy.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT B2_monitor_lam = Monitor_nD(
 xwidth = 0.06, yheight = 0.085,
 restore_neutron = 1, options = "lambda limits [0.5:10.0] bins = 130",
 filename = "BW2_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT BW2_monitor_ToF = Monitor_nD(
 xwidth = 0.06, yheight = 0.084,
 restore_neutron = 1, options = "t limits [0.0:0.050] bins = 20000",
 filename = "BW2_monitor_ToF.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// /* ---------------------- P-Choppers -------------------- */
COMPONENT PSChopper1_HR = DiskChopper(
 theta_0 = theta_width_P1_HR, radius = radius_P1,
 yheight = slit_height_P1, nu = f_P1,
 nslit = nslits_P1, delay = delay_P1_HR)
AT (0.4108460115539497, 0.0, 107.95) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP PSChopper1

COMPONENT PSChopper1_HF = DiskChopper(
 theta_0 = theta_width_P1_HF, radius = radius_P1,
 yheight = slit_height_P1, nu = f_P1,
 nslit = nslits_P1, delay = delay_P1_HF)
AT (0.4108460115539497, 0.0, 107.95) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP PSChopper1

COMPONENT PSChopper2_HR = DiskChopper(
 theta_0 = theta_width_P2_HR, radius = radius_P2,
 yheight = slit_height_P2, nu = f_P2,
 nslit = nslits_P2, delay = delay_P2_HR)
AT (0.41159673083080733, 0.0, 108.055) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP PSChopper2

COMPONENT PSChopper2_HF = DiskChopper(
 theta_0 = theta_width_P2_HF, radius = radius_P2,
 yheight = slit_height_P2, nu = f_P2,
 nslit = nslits_P2, delay = delay_P2_HF)
AT (0.41159673083080733, 0.0, 108.055) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP PSChopper2

// /* ---------------------- M-Choppers -------------------- */
COMPONENT MonoChopper1_HR = DiskChopper(
 theta_0 = theta_width_M1_HR, radius = radius_M1,
 yheight = slit_height_M1, nu = f_M1,
 nslit = nslits_M1, delay = delay_M1_HR)
AT (0.8166097806955753, 0.0, 161.995) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP MonoChopper1

COMPONENT MonoChopper1_HF = DiskChopper(
 theta_0 = theta_width_M1_HF, radius = radius_M1,
 yheight = slit_height_M1, nu = f_M1,
 nslit = nslits_M1, delay = delay_M1_HF)
AT (0.8166097806955753, 0.0, 161.995) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP MonoChopper1

COMPONENT MonoChopper2_HR = DiskChopper(
 theta_0 = theta_width_M2_HR, radius = radius_M2,
 yheight = slit_height_M2, nu = f_M2,
 nslit = nslits_M2, delay = delay_M2_HR)
AT (0.8166097806955753, 0.0, 162.005) ABSOLUTE
ROTATED (0, 0.430122381481144, 0) ABSOLUTE
GROUP MonoChopper2

COMPONENT MonoChopper2_HF = DiskChopper(
 theta_0 = theta_width_M2_HF, radius = radius_M2,
 yheight = slit_height_M2, nu = f_M2,
 nslit = nslits_M2, delay = delay_M2_HF)
AT (0.8166097806955753, 0.0, 162.005) ABSOLUTE
ROTATED (0, 0.430122381481144, 0) ABSOLUTE
GROUP MonoChopper2

FINALLY 
%{
// Start of finally for generated TRex
%}

END
