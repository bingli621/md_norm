* 
* Instrument: TRex
* 
* %Identification
* Written by: Bing Li
* Date: 17:29:28 on August 06, 2026
* Origin: DMSC
* %INSTRUMENT_SITE: Generated_instruments
* 
* !!Please write a short instrument description (1 line) here!!
* 
* %Description
* Please write a longer instrument description here!
* 
* 
* %Parameters
* L0: [unit] wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
* d_Li: [unit] wavelength band in [Å] to be simulated
* RRM: [unit] repetition rate multiplication
* phase_P: [unit] angular offset for the P-Chopper {0: 20deg Opening, 55: 35deg Opening}
* mod_type: [unit] this variable determines which moderator type is used {0: Thermal moderator, 1: Bispectral moderator, 2: Cold moderator}
* bender: [unit] bender out = 0, bender in = 1
* b_rot: [unit] in [deg], rotation of the cold neutron bender
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT TRex (
L0 = 2.4, // wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
d_Li = 0.845, // wavelength band in [Å] to be simulated
int RRM = 18, // repetition rate multiplication
int phase_P = 0, // angular offset for the P-Chopper {0: 20deg Opening, 55: 35deg Opening}
int mod_type = 1, // this variable determines which moderator type is used {0: Thermal moderator, 1: Bispectral moderator, 2: Cold moderator}
int bender = 0, // bender out = 0, bender in = 1
b_rot = -0.5 // in [deg], rotation of the cold neutron bender
)

DECLARE 
%{
double frac; // Used in the Source component. Defines the statistical fraction of eventsemitted from the cold part of the moderator, the value is determined later in the file depending on the moderator type that was chosen
double lamb_1; // Wavelength min in [AA]
double lamb_2; // Wavelength max in [AA]
double T_offset = 0.0017; // Time offset in [s] to shift to the center of long pulse
double f = 14.0; // Source frequency in [Hz]
double rTopUpPar[5] = {0.99,0.0219,3.02,4.0,0.003};
double rTopDownPar[5] = {0.99,0.0219,3.02,4.0,0.003};


double tof_BW1, tof_BW2, tof_P1, tof_P2;

// characteristic wavelength
double v0;



// distances
double L_BW1 = 32;
double L_BW2 = 40;
double L_P1 = 107.95;
double L_P2 = 108.05;

// BW1 Chopper
double f_BW1;
double radius_BW1;
char theta_pos_BW1[256] = "0";
char theta_width_BW1[256] = "61.4";
double delta_y_BW1;
double delay_BW1; //time delay
double nslits_BW1;


// BW2 Chopper
double f_BW2;
double radius_BW2;
char theta_pos_BW2[256] = "0";
char theta_width_BW2[256] = "63.3";
double delta_y_BW2;
double delay_BW2; //time delay
double nslits_BW2;

// P1 Chopper
double f_P1;
double radius_P1;
char theta_pos_P1[256] = "0 -55 -180 -235";
char theta_width_P1[256] = "2 35 2 35";
double delta_y_P1;
double delay_P1; //time delay
double nslits_P1;
double phase_P1;// angular delay


// P2 Chopper
double f_P2;
double radius_P2;
char theta_pos_P2[256] = "0 -55 -180 -235";
char theta_width_P2[256] = "2 35 2 35";
double delta_y_P2;
double delay_P2; //time delay
double nslits_P2;
double phase_P2;// angular delay



%}

INITIALIZE 
%{
// Start of initialize for generated TRex

// Source type
switch (mod_type)
	{
	case 0: {frac = 0.0; break;} // Thermal moderator
	case 1: {frac = 0.5; break;} // Bispectral moderator
	case 2: {frac = 1.0; break;} // Cold moderator
	}
// Source parameters
lamb_1 = L0-d_Li*1.1;
lamb_2 = L0+d_Li*1.1;

printf("lamb_1: %g \n", lamb_1);
printf("lamb_2: %g \n", lamb_2);

// frequencies
f_BW1 = f;
f_BW2 = f;
f_P1 = RRM*f*0.75;
f_P2 = -f_P1;

// characteristic wavelength 

v0 = 2*PI*K2V/L0;       // speed center neutron


// time of flight and chopper phases
tof_BW1 = T_offset + L_BW1/v0;
tof_BW2 = T_offset + L_BW2/v0;
tof_P1 = T_offset + L_P1/v0;
tof_P2 = T_offset + L_P2/v0;

/* Chopper parameters */

// BW1 Chopper
radius_BW1 = 0.35;
delta_y_BW1 = -0.3075;
delay_BW1 = tof_BW1; // time delay
nslits_BW1 = 1;

// BW2 Chopper
radius_BW2 = 0.35;
delta_y_BW2 = delta_y_BW1;
delay_BW2 = tof_BW2; // time delay
nslits_BW2 = 1;

// P1 Chopper
radius_P1 = 0.35;
delta_y_P1 = 0.305;
delay_P1 = tof_P1; //time delay
nslits_P1 = 4;
phase_P1 = phase_P;// angular delay



// P2 Chopper
radius_P2 = 0.35;
delta_y_P2 = delta_y_P1;
delay_P2 = tof_P2; //time delay
nslits_P2 = 4;
phase_P2 = phase_P;// angular delay


%}

TRACE 
COMPONENT source = ESS_butterfly(
 sector = "W", beamline = 7,
 yheight = 0.03, cold_frac = frac,
 dist = 2, focus_xw = 0.095,
 focus_yh = 0.035, Lmin = lamb_1,
 Lmax = lamb_2, n_pulses = 1,
 acc_power = 2, tfocus_dist = L_BW1,
 tfocus_time = tof_BW1, tfocus_width = 0.02)
AT (0, 0, 0) ABSOLUTE

// Note: -0.002 because guide is asymmetric here (47mm-43mm)/2
COMPONENT source_monitor_xy = Monitor_nD(
 xwidth = 0.1, yheight = 0.04,
 restore_neutron = 1, options = "x limits [-0.06:0.06] bins = 100, y limits [-0.03:0.03] bins = 100",
 filename = "source_monitor_xy.dat")
AT (-0.002, 0, 1.8953) ABSOLUTE

COMPONENT source_monitor_div = Monitor_nD(
 xwidth = 0.09, yheight = 0.03,
 restore_neutron = 1, options = "hdiv limits [-4.5:4.5] bins = 100, vdiv limits [-2.5:2.5] bins = 100",
 filename = "source_monitor_div.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT source_monitor_lam = Monitor_nD(
 xwidth = 0.09, yheight = 0.03,
 restore_neutron = 1, options = "lambda limits [0.5:7.0] bins = 130",
 filename = "source_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// NBOA section
COMPONENT guide_0 = Guide_anyshape_r(
 geometry = "./OFF_files/try0.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_1 = Guide_anyshape_r(
 geometry = "./OFF_files/try1.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_3 = Guide_anyshape_r(
 geometry = "./OFF_files/try3.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_4 = Guide_anyshape_r(
 geometry = "./OFF_files/try4.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_5 = Guide_anyshape_r(
 geometry = "./OFF_files/try5.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_7 = Guide_anyshape_r(
 geometry = "./OFF_files/try7.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT guide_8 = Guide_anyshape_r(
 geometry = "./OFF_files/try8.off")
AT (0, 0, 0) ABSOLUTE

// BBGOA: thermal -> guide 10 & 11; cold: bender & guide 11
COMPONENT guide_10 = Guide_anyshape_r(
 geometry = "./OFF_files/try10.off")
WHEN (bender==0)
AT (0, 0, 0) ABSOLUTE

// bender: 63.84mm x 46mm x 50mm (WxHxL), 0.15mm Si channels/ NiTi m=4 curve=7.2m
COMPONENT bender = Pol_bender(
 xwidth = 0.06384, yheight = 0.046,
 length = 0.05, radius = 7.2,
 nslit = 425, d = 1e-06,
 endFlat = 0, rTopUpPar = rTopUpPar,
 rTopDownPar = rTopDownPar, drawOption = 2)
WHEN (bender==1)
AT (-0.017, 0, 5.399) ABSOLUTE
ROTATED (0.00192, b_rot, 0) ABSOLUTE

COMPONENT guide_11 = Guide_anyshape_r(
 geometry = "./OFF_files/try11.off")
AT (0, 0, 0) ABSOLUTE

COMPONENT slit = Slit(
 xwidth = 0.06, yheight = 0.046)
AT (-0.017, 0, 5.915) ABSOLUTE

COMPONENT insert_monitor_xy = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "x limits [-0.04:0.04] bins = 100, y limits [-0.033:0.033] bins = 100",
 filename = "insert_monitor_xy.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT insert_monitor_div = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "hdiv limits [-2.0:2.0] bins = 201, vdiv limits [-1.0:1.0] bins = 201",
 filename = "insert_monitor_div.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT insert_monitor_lam = Monitor_nD(
 xwidth = 0.06, yheight = 0.046,
 restore_neutron = 1, options = "lambda limits [0.5:7.0] bins = 130",
 filename = "insert_monitor_lam.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

COMPONENT inset_monitor_ToF = Monitor_nD(
 xwidth = 0.07, yheight = 0.07,
 restore_neutron = 1, options = "t limits [0.0:0.020] bins = 20000",
 filename = "inset_monitor_ToF.dat")
AT (0, 0, 0.0001) RELATIVE PREVIOUS

// In-bunker section plus a little bit
COMPONENT guide_13 = Guide_anyshape_r(
 geometry = "./OFF_files/try13.off")
AT (0, 0, 0) ABSOLUTE

