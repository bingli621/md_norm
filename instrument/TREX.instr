// /* ---------------------- P-Choppers -------------------- */
COMPONENT PulseShapingChopper1_HR = DiskChopper(
 theta_0 = 2, radius = radius_P1,
 yheight = 0.095, nu = f_P1,
 nslit = 2, delay = delay_P1)
AT (0.4108460115539497, 0.0, 107.95) ABSOLUTE
ROTATED (0, 0.430122381481144, 180) ABSOLUTE
GROUP PulseShapingChopper1

COMPONENT PulseShapingChopper1_HF = DiskChopper(
 theta_0 = 35, radius = radius_P1,
 yheight = 0.095, nu = f_P1,
