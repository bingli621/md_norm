* Please write a longer instrument description here!
* 
* 
* %Parameters
* L0: [unit] wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
* RRM: [unit] repetition rate multiplication
* r: [unit] HR for High Resolution, HF for High Flux
* phase_P: [unit] angular offset for the P-Chopper {0: 20 deg Opening, 55: 35 deg Opening}
* phase_M: [unit] angular offset for the P-Chopper {0: 2.2 deg Opening, 4.3: 35deg Opening}
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT TRex_choppers (
L0 = 2.4, // wavelength in [Å] used to calculate the minimum and maximum wavelength for the source component by adding and subtracting a set wavelength
int RRM = 18, // repetition rate multiplication
string r = "HR", // HR for High Resolution, HF for High Flux
int phase_P = 0, // angular offset for the P-Chopper {0: 20 deg Opening, 55: 35 deg Opening}
int phase_M = 0 // angular offset for the P-Chopper {0: 2.2 deg Opening, 4.3: 35deg Opening}
)

DECLARE 
%{
double T_offset = 0.0017; // Time offset in [s] to shift to the center of long pulse
double f = 14.0; // Source frequency in [Hz]


    double tof_BW1, tof_BW2, tof_P1, tof_P2, tof_M1, tof_M2;

    // characteristic wavelength
    double v0;

    // distances
    double L_BW1 = 32;
    double L_BW2 = 40;
    double L_P1 = 107.95;
    double L_P2 = 108.05;
    double L_M1 = 161.995;
    double L_M2 = 162.005;

    


    // BW1 Chopper
    double f_BW1;
    double delay_BW1; //time delay

    double radius_BW1 = 0.35;
    double delta_y_BW1 = -0.3075;
    double nslits_BW1 = 1;
    char theta_pos_BW1[256] = "0";
    char theta_width_BW1[256] = "61.4";

    // BW2 Chopper
    double f_BW2;
    double delay_BW2; //time delay

    double radius_BW2 = 0.35;
    double delta_y_BW2 = -0.3075;
    double nslits_BW2 = 1;
    char theta_pos_BW2[256] = "0";
    char theta_width_BW2[256] = "63.3";

    // P1 Chopper
    double f_P1;
    double delay_P1; //time delay
    double phase_P1;// angular delay

    double radius_P1 = 0.35;
    double delta_y_P1 = 0.305;
    double nslits_P1 = 4;
    char theta_pos_P1[256] = "0;55;180;235"; // positive for CW
    char theta_width_P1[256] = "20;35;20;35";

    // P2 Chopper
    double f_P2;
    double delay_P2; //time delay
    double phase_P2;// angular delay

    double radius_P2 = 0.35;
    double delta_y_P2 = 0.305;
    double nslits_P2 = 4;
    char theta_pos_P2[256] = "0;55;180;235"; // positive for CW
    char theta_width_P2[256] = "20;35;20;35";



    // M1 Chopper
    double f_M1;
    double delay_M1; //time delay
    double phase_M1;// angular delay

    double radius_M1 = 0.35;
    double delta_y_M1 = 0.325;
    double nslits_M1 = 2;
    //char theta_pos_M1[256] = "0;175"; // positive for CW
    char theta_pos_M1[256] = "-180;-5"; // positive for CW
    char theta_width_M1[256] = "2.5;4.4";


    // M2 Chopper
    double f_M2;
    double delay_M2; //time delay
    double phase_M2;// angular delay

    double radius_M2 = 0.35;
    double delta_y_M2 = -0.325;
    double nslits_M2 = 2;
    char theta_pos_M2[256] = "0;175"; // positive for CW
    char theta_width_M2[256] = "2.5;4.4";

    
%}

INITIALIZE 
%{
// Start of initialize for generated TRex_choppers

    // frequencies

    f = 0.0001;

    f_BW1 = f;
    f_BW2 = f_BW1;
    f_P1 = RRM*f*0.75;
    f_P2 = -f_P1;
    f_M1 = RRM*f;
    f_M2 = -f_M1;

    //TODO
    // Resolution Settings
    //"angular offset for the P-Chopper {0: 20deg Opening, 55: 35deg Opening}",
    // angular offset for the M-Chopper {0: 2.5deg Opening, 177: 4,3deg Opening}
    //if (strcmp(r,"HR") == 0){
    //
    //} else if (strcmp(r,"HF") == 0){
    //
    //} else {
    //    printf("Need valid resolution option, 'HR' or 'HF'");
    //}


    // characteristic wavelength 

    v0 = 2*PI*K2V/L0; // speed center neutron


    // time of flight and chopper phases
    tof_BW1 = T_offset + L_BW1/v0;
    tof_BW2 = T_offset + L_BW2/v0;
    tof_P1 = T_offset + L_P1/v0;
    tof_P2 = T_offset + L_P2/v0;
    tof_M1 = T_offset + L_M1/v0;
    tof_M2 = T_offset + L_M2/v0;

    delay_BW1 = tof_BW1; //time delay
    delay_BW2 = tof_BW2; //time delay
    delay_P1 = tof_P1; //time delay
    delay_P2 = tof_P2; //time delay
    delay_M1 = tof_M1; //time delay
    delay_M2 = tof_M1; //time delay

    phase_P1 = phase_P;// angular delay
    phase_P2 = phase_P;// angular delay
    phase_M1 = phase_M;// angular delay
    phase_M2 = phase_M;// angular delay

    
%}

TRACE 
COMPONENT Source = Source_div(
 xwidth = radius_M2* 2.5, yheight = radius_M2* 2.5,
 focus_aw = 0.001, focus_ah = 0.001,
 E0 = 5, dE = 0.1)
AT (0.8166097806955753, delta_y_M2, 161.995) ABSOLUTE

COMPONENT MonochromatingChopper2 = MultiDiskChopper(
 slit_center = theta_pos_M2, slit_width = theta_width_M2,
 nslits = nslits_M2, delta_y = delta_y_M2,
 nu = f_M2, delay = delay_M2,
 radius = radius_M2)
AT (0.8166097806955753, 0.0, 162.005) ABSOLUTE
ROTATED (0, 0.430122381481144, 0) ABSOLUTE

COMPONENT PSD = PSD_monitor(
 nx = 300, ny = 300,
 xwidth = radius_M2* 2.5, yheight = radius_M2* 2.5)
AT (0, 0, 0.5) RELATIVE Source

FINALLY 
%{
// Start of finally for generated TRex_choppers
%}

END
