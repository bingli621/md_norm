COMPONENT MonochromatingChopper1 = MultiDiskChopper(
 slit_center = theta_pos_M1, slit_width = theta_width_M1,
 nslits = nslits_M1, delta_y = delta_y_M1,
 nu = f_M1, delay = delay_M1,
 phase = phase_M1, radius = radius_M1)
AT (position_M1[0], position_M1[1], position_M1[2]) ABSOLUTE
ROTATED (rotation_M1[0], rotation_M1[1], rotation_M1[2]) ABSOLUTE

COMPONENT MonochromatingChopper2 = MultiDiskChopper(
 slit_center = theta_pos_M2, slit_width = theta_width_M2,
 nslits = nslits_M2, delta_y = delta_y_M2,
 nu = f_M2, delay = delay_M2,
 phase = phase_M2, radius = radius_M2)
AT (position_M2[0], position_M2[1], position_M2[2]) ABSOLUTE
ROTATED (rotation_M2[0], rotation_M2[1], rotation_M2[2]) ABSOLUTE

COMPONENT slitMC = Slit(
 xwidth = 0.0205, yheight = 0.0345)
AT (0.817, 0, 162.07) ABSOLUTE

