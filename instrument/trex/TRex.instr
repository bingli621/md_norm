 l = 1.08, nslit = 5,
 d = 0.0005)
WHEN (coll==1)
AT (0.817, 0, 162.07) ABSOLUTE
ROTATED (0, 0.430122381481144, 0) ABSOLUTE

COMPONENT coll2 = Guide_honeycomb(
 w1 = 0.03523, w2 = 0.0292,
